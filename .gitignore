# Environment variables
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
lerna-debug.log*

# Dependency directories
node_modules/

# Build outputs
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Images uploads
backend/images/*
!backend/images/.gitkeep

# Fichiers déposés par les utilisateurs : travaux non publiés, photos, pièces
# jointes d'annonces. Ils vivent sur le serveur (montage de l'hôte), jamais
# dans le dépôt — quatre PDF de soumission s'y étaient retrouvés, sur un dépôt
# public.
# Pas de .gitkeep à conserver : chaque middleware crée son dossier au besoin
# (fs.mkdirSync avec recursive).
backend/uploads/**

# Copies locales du fichier de configuration (contiennent les secrets)
.env.prod-backup
**/.env.prod-backup
.env.dev-backup
**/.env.dev-backup
*.env.backup

# Sensitive local docs
docs/DEV_CREDENTIALS.md
