# Environment
NODE_ENV=development

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here

# Email Service (Resend)
RESEND_API=your_resend_api_key_here
RESEND_EMAIL=your_email@example.com

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Paiement manuel (coordonnées à afficher aux utilisateurs)
PAYMENT_INFO_IBAN=FR76 3000 6000 0112 3456 7890 189
PAYMENT_INFO_BANK_ACCOUNT=
PAYMENT_INFO_ORANGE=002376XXXXXXXX
PAYMENT_INFO_MTN=002376YYYYYYYY
ADMIN_EMAIL=admin@example.org

# Upload PDF (Working Papers)
# Taille max en MB (ex: 10, 15, 20)
PDF_MAX_SIZE_MB=10

